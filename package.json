{
  "name": "rutero",
  "productName": "Rutero",
  "version": "1.3.8",
  "description": "Compañero de ruta para Euro Truck Simulator 2 y American Truck Simulator, conectado con TruckersMP",
  "main": "src/main/main.js",
  "author": "Rutero",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "portable": "electron-builder --win portable --x64",
    "publicar": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.rutero.app",
    "productName": "Rutero",
    "copyright": "Rutero",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "config/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "plugin",
        "to": "plugin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Rutero-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Rutero",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-512.png",
      "category": "public.app-category.games",
      "identity": "-",
      "artifactName": "Rutero-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Rutero-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-512.png",
      "category": "Game",
      "artifactName": "Rutero-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ruteroapp",
        "repo": "rutero",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Rutero",
        "schemes": [
          "rutero"
        ]
      }
    ]
  }
}
