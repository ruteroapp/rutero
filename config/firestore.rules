rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function company(cid) { return get(/databases/$(db)/documents/companies/$(cid)).data; }
    function isOwner(cid) { return signed() && company(cid).ownerUid == me(); }
    function isManager(cid) {
      return isOwner(cid) || (signed() && exists(/databases/$(db)/documents/companies/$(cid)/members/$(me()))
        && get(/databases/$(db)/documents/companies/$(cid)/members/$(me())).data.role == 'admin');
    }
    // permisos por rol (Roles y permisos): gerentes y fundador lo tienen todo
    function memberDoc(cid) { return get(/databases/$(db)/documents/companies/$(cid)/members/$(me())).data; }
    function can(cid, p) {
      return isManager(cid) || (signed() && exists(/databases/$(db)/documents/companies/$(cid)/members/$(me()))
        && p in (memberDoc(cid).get('title', '') != '' && company(cid).get('rolePerms', {}).get(memberDoc(cid).title, null) != null
          ? company(cid).rolePerms[memberDoc(cid).title] : company(cid).get('basePerms', [])));
    }
    // compra de una empresa puesta a la venta: el comprador queda como dueño en el mismo lote
    function buying(cid) {
      return signed() && get(/databases/$(db)/documents/companies/$(cid)).data.get('forSale', false) == true
        && getAfter(/databases/$(db)/documents/companies/$(cid)).data.ownerUid == me();
    }
    // existsAfter: cuenta los cambios del mismo lote (al fundar o unirse)
    function isBotAdmin() { return signed() && get(/databases/$(db)/documents/config/discord).data.adminUid == me(); }
    function isMember(cid) { return signed() && existsAfter(/databases/$(db)/documents/companies/$(cid)/members/$(me())); }

    // ---------- conductores ----------
    match /users/{uid} {
      allow read: if signed();
      allow create, update: if signed() && me() == uid;
      match /jobs/{job} { allow read: if signed(); allow create: if signed() && me() == uid; }
      match /fines/{f} { allow read: if signed(); allow create: if signed() && me() == uid; }
      match /transfers/{t} { allow read, create: if signed() && me() == uid; }
      // dinero recibido de otros conductores: lo crea quien envía, lo cobra el dueño
      match /inbox/{i} {
        allow create: if signed() && request.resource.data.fromUid == me() && request.resource.data.amount > 0;
        allow read, delete: if signed() && me() == uid;
      }
    }

    // ---------- empresas ----------
    match /companies/{cid} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.ownerUid == me();
      allow update: if isManager(cid)
        || (signed() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['km', 'jobs', 'balance', 'membersCount', 'lastActivity', 'ratingSum', 'ratingCount', 'loan']))
        || (signed() && resource.data.get('forSale', false) == true && request.resource.data.ownerUid == me()
            && request.resource.data.forSale == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'ownerName', 'forSale', 'salePrice', 'lastActivity', 'membersCount']))
        || (can(cid, 'comprar') && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['balance', 'lastActivity', 'busUnlocked', 'busUnlockedAt', 'busGiftClaimed']));
      allow delete: if isOwner(cid);

      match /members/{uid} {
        allow read: if signed();
        allow create: if signed() && me() == uid;
        // el propio conductor no puede cambiarse el rol ni el puesto
        allow update: if (signed() && me() == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'title'])) || isManager(cid)
          || (buying(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
        allow delete: if (signed() && me() == uid) || isManager(cid);
      }
      match /requests/{uid} {
        allow read: if signed();
        allow create, update: if (signed() && me() == uid) || isManager(cid);
        allow delete: if (signed() && me() == uid) || isManager(cid);
      }
      // valoraciones: una por conductor (1 a 5 estrellas), nunca del dueño
      match /ratings/{uid} {
        allow read: if signed();
        allow create, update: if signed() && me() == uid && company(cid).ownerUid != me()
          && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
        allow delete: if signed() && me() == uid;
      }
      match /jobs/{job} { allow read: if signed(); allow create: if isMember(cid); }
      match /fines/{f} { allow read: if signed(); allow create: if isMember(cid); }
      match /bank/{mov} { allow read: if signed(); allow create: if isMember(cid) || isBotAdmin(); }
      match /accounts/{a} {
        allow read: if signed();
        allow write: if can(cid, 'dinero');
        // la cuenta de empresa la crea la primera comisión que entra (cualquier miembro)
        allow create: if isMember(cid) && a == 'empresa' && request.resource.data.keys().hasOnly(['name', 'balance']);
        allow update: if isMember(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']);
      }
      match /fleet/{v} {
        allow read: if signed();
        allow write: if can(cid, 'comprar') || can(cid, 'vender') || can(cid, 'flota') || can(cid, 'reparar');
        // el conductor asignado solo puede actualizar el desgaste y los km
        allow update: if isMember(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['condition', 'km', 'lastDriver']);
      }
      match /garages/{g} { allow read: if signed(); allow write: if can(cid, 'comprar') || can(cid, 'vender'); }
      match /news/{n} { allow read: if signed(); allow write: if can(cid, 'noticias'); }
      match /liveries/{l} { allow read: if signed(); allow write: if can(cid, 'disenos'); }
      match /busroutes/{r} {
        allow read: if signed();
        allow write: if can(cid, 'rutas');
        // cualquier conductor de la empresa puede guardar dónde están las paradas
        allow update: if isMember(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stopPos']);
      }
      match /events/{e} {
        allow read: if signed();
        allow create, delete: if can(cid, 'eventos');
        allow update: if can(cid, 'eventos') || (isMember(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'maybe', 'notGoing']));
      }
    }

    // ---------- reportes: cualquiera con cuenta puede enviar, nadie puede leerlos desde la app ----------
    match /reports/{r} {
      allow create: if signed() && request.resource.data.reporterUid == me();
    }

    // ---------- rankings semanales ----------
    match /weekly/{week}/drivers/{uid} {
      allow read: if signed();
      allow write: if signed() && me() == uid;
    }
    match /weekly/{week}/companies/{cid} {
      allow read: if signed();
      allow write: if isMember(cid);
    }
    // ---------- bot de Discord ----------
    match /config/discord {
      allow read: if signed();
      allow create: if signed() && request.resource.data.adminUid == me();
      allow update: if signed() && resource.data.adminUid == me() && request.resource.data.adminUid == me();
    }
    match /discordQueue/{q} {
      allow create: if signed() && request.resource.data.by == me() && isManager(request.resource.data.cid)
        && (request.resource.data.type != 'promo' || !('lastPromoAt' in company(request.resource.data.cid))
            || company(request.resource.data.cid).lastPromoAt < request.time - duration.value(14, 'd'));
      allow read, delete: if isBotAdmin();
    }
    match /discordReleases/{tag} {
      allow read, create: if signed();
    }
    match /discordMap/{cid} {
      allow read: if signed();
      allow write: if isBotAdmin();
    }
  }
}
